ils.faq[open] summary .plus {transform: rotate(45deg)}\n  details.faq[open] {box-shadow: 6px 6px 0 var(--orange)}\n\n  @keyframes slideIn { from {opacity: 0;transform: translateY(30px)} to {opacity: 1;transform: none} }\n  .anim {animation: slideIn .7s cubic-bezier(.2,.8,.3,1) both}\n  .marquee {display: flex;gap: 3rem;animation: scroll 18s linear infinite;white-space: nowrap}\n  @keyframes scroll { to {transform: translateX(-50%)} }\n</style>\n<nav class=\"fixed left-0 top-0 h-full w-16 md:w-20 bg-white border-r-4 border-black flex flex-col items-center py-6 z-50\">\n  <a href=\"#top\" class=\"mb-6 text-center leading-none\">\n    <span class=\"block text-3xl font-black\">Z</span>\n    <span class=\"text-[10px] font-bold tracking-widest\">梯子Z</span>\n  </a>\n  <div class=\"side-line flex-1 my-4\"></div>\n  <div class=\"side-nav flex flex-col gap-8 text-sm font-bold\">\n    <a href=\"#top\">首屏</a>\n    <a href=\"#plans\">方案</a>\n    <a href=\"#compare\">对比</a>\n    <a href=\"#faq\">问答</a>\n  </div>\n  <div class=\"side-line flex-1 my-4\"></div>\n  <span class=\"text-[10px] text-gray-400\">7735</span>\n</nav>\n\n<main class=\"ml-16 md:ml-20 w-full\">\n\n\n<header id=\"top\" class=\"band bg-white pt-16 pb-24 px-6 md:px-16\">\n  <div class=\"band-stripe top-8\"></div>\n  <div class=\"band-stripe top-16\"></div>\n  <div class=\"band-stripe top-24\"></div>\n  <div class=\"band-stripe top-32\"></div>\n\n  <div class=\"relative max-w-5xl mx-auto mt-40\">\n    <p class=\"anim inline-block badge mb-6\">朋友,梯子得稳</p>\n    <h1 class=\"anim text-5xl md:text-7xl font-black leading-tight\">梯子Z · \n      一把靠谱梯子,<br><span>陪你翻得又快又稳。</span>\n    </h1>\n    <p class=\"anim mt-6 text-lg text-gray-600 max-w-xl\">\n      梯子Z 不整虚的:极速流量、原生流媒体解锁、IPLC 游戏专线,全都明码标价。挑一个适合你的,咱们说走就走。\n    </p>\n    <div class=\"anim mt-8 flex gap-4 flex-wrap\">\n      <a href=\"#plans\" class=\"btn-z solid px-8 py-4 text-lg\">看看方案 →</a>\n      <a href=\"#compare\" class=\"btn-z px-8 py-4 text-lg\">先对比再说</a>\n    </div>\n  </div>\n\n  \n  <div class=\"mt-20 py-4 overflow-hidden\">\n    <div class=\"marquee text-white font-black text-lg\">\n      <span>⚡ 极速节点</span><span>🎬 流媒体解锁</span><span>🎮 IPLC 游戏加速</span><span>🛡️ 稳定不掉线</span><span>💬 7×24 工单</span>\n      <span>⚡ 极速节点</span><span>🎬 流媒体解锁</span><span>🎮 IPLC 游戏加速</span><span>🛡️ 稳定不掉线</span><span>💬 7×24 工单</span>\n    </div>\n  </div>\n</header>\n\n\n<section id=\"plans\" class=\"px-6 md:px-16 py-20 max-w-6xl mx-auto\">\n  <h2 class=\"text-4xl font-black mb-2\">三档方案,总有一款合你心意</h2>\n  <p class=\"text-gray-500 mb-12\">按年付更划算,省下的钱多喝两杯咖啡 ☕</p>\n\n  <div class=\"grid md:grid-cols-3 gap-10\">\n    \n    <div class=\"brutal p-8 bg-white flex flex-col\">\n      <h3 class=\"text-2xl font-black\">基础版</h3>\n      <p class=\"text-sm text-gray-500 mt-1\">入门首选,轻装上阵</p>\n      <div class=\"mt-6\">\n        <span class=\"text-4xl font-black\">¥15</span><span class=\"text-gray-500\">/月</span>\n        <p class=\"text-sm font-bold mt-1\">按年付仅需 ¥150/年</p>\n      </div>\n      <ul class=\"mt-6 space-y-3 text-sm flex-1\">\n        <li>✅ 每月 100GB 极速流量</li>\n        <li>✅ 支持 3 台设备同时在线</li>\n        <li>✅ 解锁基础流媒体</li>\n        <li>✅ 普通线路节点池</li>\n      </ul>\n      \n    </div>\n\n    \n    <div class=\"brutal brutal-featured p-8 bg-white flex flex-col relative\">\n      <span class=\"badge absolute -top-3 right-6\">最受欢迎 🔥</span>\n      <h3 class=\"text-2xl font-black\">旗舰版</h3>\n      <p class=\"text-sm text-gray-500 mt-1\">一步到位,畅快到底</p>\n      <div class=\"mt-6\">\n        <span class=\"text-4xl font-black\">¥35</span><span class=\"text-gray-500\">/月</span>\n        <p class=\"text-sm font-bold mt-1\">按年付仅需 ¥350/年</p>\n      </div>\n      <ul class=\"mt-6 space-y-3 text-sm flex-1\">\n        <li>✅ 每月 300GB 极速流量</li>\n        <li>✅ 支持 5 台设备同时在线</li>\n        <li>✅ 全节点原生流媒体解锁</li>\n        <li>✅ IPLC 专线游戏加速优化</li>\n        <li>✅ 7×24 优先工单支持</li>\n      </ul>\n      \n    </div>\n\n    \n    <div class=\"brutal p-8 bg-white flex flex-col\">\n      <h3 class=\"text-2xl font-black\">团队版</h3>\n      <p class=\"text-sm text-gray-500 mt-1\">给团队的全套装备</p>\n      <div class=\"mt-6\">\n        <span class=\"text-4xl font-black\">¥85</span><span class=\"text-gray-500\">/月</span>\n        <p class=\"text-sm font-bold mt-1\">按年付仅需 ¥850/年</p>\n      </div>\n      <ul class=\"mt-6 space-y-3 text-sm flex-1\">\n        <li>✅ 每月 1000GB 极速流量</li>\n        <li>✅ 支持 20 台设备同时在线</li>\n        <li>✅ VIP 专属高带宽节点</li>\n        <li>✅ 支持企业定制路由</li>\n        <li>✅ 专属客户经理服务</li>\n      </ul>\n      \n    </div>\n  </div>\n</section>\n\n\n<section id=\"compare\" class=\"px-6 md:px-16 py-20 bg-[#FFF3EC]\">\n  <div class=\"max-w-6xl mx-auto\">\n    <h2 class=\"text-4xl font-black mb-2\">横向拉出来遛一遛</h2>\n    <p class=\"text-gray-500 mb-10\">所有配置一目了然,不玩文字游戏。</p>\n    <div class=\"overflow-x-auto bg-white brutal\">\n      <table class=\"compare text-sm min-w-[640px]\">\n        <thead>\n          <tr>\n            <th class=\"text-left\">对比项</th>\n            <th>基础版</th>\n            <th class=\"featured-col\">旗舰版 🔥</th>\n            <th>团队版</th>\n          </tr>\n        </thead>\n        <tbody>\n          <tr><td class=\"font-bold\">月付价格</td><td>¥15/月</td><td class=\"featured-col font-bold\">¥35/月</td><td>¥85/月</td></tr>\n          <tr><td class=\"font-bold\">年付价格</td><td>¥150/年</td><td class=\"featured-col font-bold\">¥350/年</td><td>¥850/年</td></tr>\n          <tr><td class=\"font-bold\">每月流量</td><td>100GB</td><td class=\"featured-col font-bold\">300GB</td><td>1000GB</td></tr>\n          <tr><td class=\"font-bold\">同时在线设备</td><td>3 台</td><td class=\"featured-col font-bold\">5 台</td><td>20 台</td></tr>\n          <tr><td class=\"font-bold\">流媒体解锁</td><td>基础解锁</td><td class=\"featured-col font-bold\">全节点原生解锁</td><td>全节点原生解锁</td></tr>\n          <tr><td class=\"font-bold\">节点线路</td><td>普通节点池</td><td class=\"featured-col font-bold\">全节点 + IPLC 专线</td><td>VIP 高带宽专属节点</td></tr>\n          <tr><td class=\"font-bold\">游戏加速</td><td>—</td><td class=\"featured-col font-bold\">IPLC 专线优化</td><td>IPLC 专线优化</td></tr>\n          <tr><td class=\"font-bold\">企业定制路由</td><td>—</td><td class=\"featured-col\">—</td><td>✔</td></tr>\n          <tr><td class=\"font-bold\">客服支持</td><td>标准工单</td><td class=\"featured-col font-bold\">7×24 优先工单</td><td>专属客户经理</td></tr>\n        </tbody>\n      </table>\n    </div>\n  </div>\n</section>\n\n\n<section id=\"faq\" class=\"px-6 md:px-16 py-20 max-w-6xl mx-auto\">\n  <h2 class=\"text-4xl font-black mb-2\">朋友常问的几件事</h2>\n  <p class=\"text-gray-500 mb-10\">还有疑问?随时来撩客服,我们很健谈 😄</p>\n\n  <div class=\"grid md:grid-cols-2 gap-6\">\n    <details class=\"faq p-6 bg-white\">\n      <summary class=\"flex justify-between items-center\">流量月底没用完会清零吗?<span class=\"plus text-2xl\">+</span></summary>\n      <p class=\"mt-3 text-sm text-gray-600\">会的哦,流量按自然月结算重置。建议根据自己的用量选档,别浪费也别憋屈。</p>\n    </details>\n    <details class=\"faq p-6 bg-white\">\n      <summary class=\"flex justify-between items-center\">可以同时登录几台设备?<span class=\"plus text-2xl\">+</span></summary>\n      <p class=\"mt-3 text-sm text-gray-600\">基础版 3 台、旗舰版 5 台、团队版 20 台同时在线。手机、电脑、平板一起用完全没问题。</p>\n    </details>\n    <details class=\"faq p-6 bg-white\">\n      <summary class=\"flex justify-between items-center\">流媒体解锁是原生 IP 吗?<span class=\"plus text-2xl\">+</span></summary>\n      <p class=\"mt-3 text-sm text-gray-600\">旗舰版和团队版全节点均为原生解锁,看剧追番画质拉满,不会有「代理检测」的烦人提示。</p>\n    </details>\n    <details class=\"faq p-6 bg-white\">\n      <summary class=\"flex justify-between items-center\">打游戏延迟怎么样?<span class=\"plus text-2xl\">+</span></summary>\n      <p class=\"mt-3 text-sm text-gray-600\">旗舰版起自带 IPLC 专线游戏加速,走专线不绕路,团战开黑稳得很。</p>\n    </details>\n    <details class=\"faq p-6 bg-white\">\n      <summary class=\"flex justify-between items-center\">能中途升级套餐吗?<span class=\"plus text-2xl\">+</span></summary>\n      <p class=\"mt-3 text-sm text-gray-600\">当然可以!升级即时生效,差价按剩余天数折算,老朋友绝不让你吃亏。</p>\n    </details>\n    <details class=\"faq p-6 bg-white\">\n      <summary class=\"flex justify-between items-center\">不满意能退款吗?<span class=\"plus text-2xl\">+</span></summary>\n      <p class=\"mt-3 text-sm text-gray-600\">新用户 3 天内支持无理由退款。合不合适,试了才知道,我们给足你试错空间。</p>\n    </details>\n  </div>\n\n  \n  <div class=\"brutal mt-16 p-10 text-center bg-white\">\n    <h3 class=\"text-3xl font-black\">准备好了?<span>梯子已经给你架好了。</span></h3>\n    <p class=\"text-gray-500 mt-2\">挑个方案,三分钟后你就能在新世界里冲浪。</p>\n    <a href=\"#plans\" class=\"btn-z solid inline-block px-10 py-4 mt-6 text-lg\">立即上车 →</a>\n  </div>\n</section>\n\n<footer class=\"border-t-4 border-black px-6 md:px-16 py-8 text-sm text-gray-500 flex flex-wrap gap-4 justify-between max-w-full\">\n  <span><b>梯子Z</b> · 稳一点,快一点</span>\n  <span>© 2025 梯子Z — 与朋友同行</span>\n</footer>\n</main>\n\n",
